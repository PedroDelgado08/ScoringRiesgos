# =====================================================================
# .gitignore - What is NOT pushed to GitHub
# =====================================================================

# --- Secrets and account configuration --------------------------------
.env
.env.*
# Identifies the AWS account: only the .example is versioned
samconfig.toml

# --- Generated by AWS SAM (rebuilt with "sam build") -------------------
.aws-sam/

# --- Data and models (not published: course material) -----------------
# Tabular data
*.csv
*.xlsx
*.parquet
*.feather
*.db
*.sqlite
*.duckdb
# Serialized data and artifacts (pickle, joblib)
*.pkl
*.joblib
# Data and results folders
02_datos/
06_resultados/

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# --- System and IDE -----------------------------------------------------
desktop.ini
Thumbs.db
.vscode/
.idea/
*.log
